# AgentBreak Backend Environment Configuration (Example)
PROJECT_NAME=AgentBreak
VERSION=0.1.0
API_V1_STR=/api
ENVIRONMENT=development

# SQLite database path
DATABASE_URL=sqlite:///./agentbreak.db

# CORS Allowed Origins (comma-separated JSON list syntax or default list)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Phase 2 adaptive red-team model. Keep your real key in backend/.env, never in source.
# Gemini Free Tier starts without billing; keep this project on the Free Tier.
# Free-tier prompt data may be used by Google to improve its products.
AGENTBREAK_LLM_PROVIDER=gemini
AGENTBREAK_LLM_MODEL=gemini-3.5-flash-lite
AGENTBREAK_LLM_API_KEY=
AGENTBREAK_LLM_TIMEOUT_SECONDS=25
